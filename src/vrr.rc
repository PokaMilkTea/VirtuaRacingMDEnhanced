// vrr.exe's Windows resources: the manifest and the version information Explorer shows
#include <winver.h>
#include "version.h"

1 24 "vrr.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VRR_VERSION_NUMBERS
PRODUCTVERSION  VRR_VERSION_NUMBERS
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription",  "Virtua Racing enhanced frontend (non-commercial)"
      VALUE "FileVersion",      VRR_VERSION
      VALUE "InternalName",     "vrr"
      VALUE "OriginalFilename", "vrr.exe"
      VALUE "ProductName",      "VirtuaRacingMDEnhanced"
      VALUE "ProductVersion",   VRR_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
